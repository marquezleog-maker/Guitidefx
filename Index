<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>GuiTideFX | Multi-Strategy MT4 Trading System</title>

  <meta
    name="description"
    content="GuiTideFX is a multi-strategy MetaTrader 4 trading system combining London Daybreak, Baseline Breakout, and 3-Layer Support and Resistance with portfolio risk controls."
  />

  <meta
    name="keywords"
    content="GuiTideFX, MetaTrader 4, MT4 EA, forex expert advisor, London breakout, forex automation"
  />

  <meta name="theme-color" content="#071323" />

  <!-- Replace these before publishing -->
  <meta property="og:title" content="GuiTideFX Multi-Strategy Trader" />
  <meta property="og:description" content="Rule-based automation with portfolio risk control." />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="assets/hero-banner.png" />
  <meta property="og:url" content="https://www.yourdomain.com/" />

  <style>
    :root {
      --background: #050b14;
      --background-soft: #091525;
      --panel: rgba(11, 28, 49, 0.82);
      --panel-solid: #0b1c31;
      --panel-light: #102844;

      --primary: #21b9ff;
      --primary-dark: #087fbd;
      --gold: #f0b94f;
      --green: #1bc97a;
      --red: #ec5757;

      --text: #f4f8fc;
      --text-soft: #bbc7d5;
      --text-muted: #8090a4;

      --border: rgba(119, 172, 213, 0.2);
      --border-bright: rgba(33, 185, 255, 0.45);

      --shadow: 0 22px 70px rgba(0, 0, 0, 0.42);
      --radius: 22px;
      --container: 1180px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      overflow-x: hidden;
      color: var(--text);
      background:
        radial-gradient(circle at 82% 12%, rgba(33, 185, 255, 0.12), transparent 31%),
        radial-gradient(circle at 12% 48%, rgba(240, 185, 79, 0.06), transparent 28%),
        var(--background);
      font-family:
        Inter,
        "Segoe UI",
        Roboto,
        Helvetica,
        Arial,
        sans-serif;
      line-height: 1.6;
    }

    body.menu-open {
      overflow: hidden;
    }

    img {
      display: block;
      width: 100%;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }

    .container {
      width: min(calc(100% - 40px), var(--container));
      margin: 0 auto;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      margin-bottom: 16px;
      color: var(--primary);
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .eyebrow::before {
      width: 30px;
      height: 2px;
      content: "";
      background: linear-gradient(90deg, var(--primary), transparent);
    }

    .section {
      position: relative;
      padding: 104px 0;
    }

    .section-header {
      width: min(100%, 760px);
      margin: 0 auto 54px;
      text-align: center;
    }

    .section-header h2 {
      margin-bottom: 16px;
      font-size: clamp(2rem, 4vw, 3.25rem);
      line-height: 1.12;
    }

    .section-header p {
      color: var(--text-soft);
      font-size: 1.05rem;
    }

    .gradient-text {
      color: transparent;
      background: linear-gradient(135deg, #ffffff, #6ed5ff 58%, #f0b94f);
      -webkit-background-clip: text;
      background-clip: text;
    }

    /* Header */

    .site-header {
      position: fixed;
      z-index: 1000;
      top: 0;
      left: 0;
      width: 100%;
      border-bottom: 1px solid transparent;
      transition:
        background-color 0.25s ease,
        border-color 0.25s ease,
        backdrop-filter 0.25s ease;
    }

    .site-header.scrolled {
      border-color: var(--border);
      background: rgba(5, 11, 20, 0.88);
      -webkit-backdrop-filter: blur(16px);
      backdrop-filter: blur(16px);
    }

    .nav {
      display: flex;
      min-height: 76px;
      align-items: center;
      justify-content: space-between;
      gap: 30px;
    }

    .logo {
      display: inline-flex;
      align-items: center;
      gap: 11px;
      font-size: 1.22rem;
      font-weight: 900;
      letter-spacing: -0.03em;
    }

    .logo-mark {
      display: grid;
      width: 38px;
      height: 38px;
      place-items: center;
      border: 1px solid rgba(33, 185, 255, 0.6);
      border-radius: 12px;
      color: var(--primary);
      background:
        linear-gradient(145deg, rgba(33, 185, 255, 0.18), rgba(240, 185, 79, 0.08));
      box-shadow: 0 0 24px rgba(33, 185, 255, 0.18);
    }

    .logo-accent {
      color: var(--primary);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 28px;
      list-style: none;
    }

    .nav-links a {
      position: relative;
      color: var(--text-soft);
      font-size: 0.92rem;
      font-weight: 700;
      transition: color 0.2s ease;
    }

    .nav-links a:not(.button)::after {
      position: absolute;
      bottom: -9px;
      left: 0;
      width: 0;
      height: 2px;
      content: "";
      background: var(--primary);
      transition: width 0.2s ease;
    }

    .nav-links a:hover {
      color: var(--text);
    }

    .nav-links a:hover::after {
      width: 100%;
    }

    .menu-button {
      display: none;
      width: 44px;
      height: 44px;
      border: 1px solid var(--border);
      border-radius: 12px;
      color: var(--text);
      background: var(--panel);
      cursor: pointer;
    }

    /* Buttons */

    .button {
      display: inline-flex;
      min-height: 48px;
      align-items: center;
      justify-content: center;
      gap: 9px;
      padding: 0 22px;
      border: 1px solid transparent;
      border-radius: 13px;
      font-size: 0.92rem;
      font-weight: 800;
      cursor: pointer;
      transition:
        transform 0.2s ease,
        border-color 0.2s ease,
        background-color 0.2s ease,
        box-shadow 0.2s ease;
    }

    .button:hover {
      transform: translateY(-2px);
    }

    .button-primary {
      color: #021019;
      background: linear-gradient(135deg, #57d0ff, var(--primary));
      box-shadow: 0 12px 32px rgba(33, 185, 255, 0.2);
    }

    .button-primary:hover {
      box-shadow: 0 15px 42px rgba(33, 185, 255, 0.32);
    }

    .button-secondary {
      border-color: var(--border-bright);
      color: var(--text);
      background: rgba(9, 25, 42, 0.76);
    }

    .button-gold {
      color: #181000;
      background: linear-gradient(135deg, #ffd77e, var(--gold));
      box-shadow: 0 12px 32px rgba(240, 185, 79, 0.17);
    }

    /* Hero */

    .hero {
      position: relative;
      display: flex;
      min-height: 840px;
      align-items: center;
      overflow: hidden;
      padding: 145px 0 90px;
    }

    .hero::before {
      position: absolute;
      inset: 0;
      pointer-events: none;
      content: "";
      background-image:
        linear-gradient(rgba(61, 130, 177, 0.055) 1px, transparent 1px),
        linear-gradient(90deg, rgba(61, 130, 177, 0.055) 1px, transparent 1px);
      background-size: 48px 48px;
      mask-image: linear-gradient(to bottom, black, transparent 85%);
    }

    .hero-grid {
      position: relative;
      z-index: 1;
      display: grid;
      align-items: center;
      gap: 62px;
      grid-template-columns: minmax(0, 1fr) minmax(440px, 0.95fr);
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      margin-bottom: 22px;
      padding: 7px 12px;
      border: 1px solid rgba(33, 185, 255, 0.28);
      border-radius: 999px;
      color: #90dcff;
      background: rgba(33, 185, 255, 0.07);
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .status-dot {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: var(--green);
      box-shadow: 0 0 12px var(--green);
    }

    .hero h1 {
      max-width: 760px;
      margin-bottom: 24px;
      font-size: clamp(3.2rem, 7vw, 6.2rem);
      letter-spacing: -0.065em;
      line-height: 0.94;
    }

    .hero h1 span {
      display: block;
      margin-top: 14px;
      color: var(--gold);
      font-size: 0.54em;
      letter-spacing: -0.035em;
      line-height: 1.03;
    }

    .hero-description {
      max-width: 680px;
      margin-bottom: 32px;
      color: var(--text-soft);
      font-size: clamp(1rem, 2vw, 1.16rem);
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-bottom: 34px;
    }

    .hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 24px;
      color: var(--text-muted);
      font-size: 0.86rem;
    }

    .hero-meta span {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .check {
      display: grid;
      width: 19px;
      height: 19px;
      place-items: center;
      border-radius: 50%;
      color: #06110c;
      background: var(--green);
      font-size: 0.7rem;
      font-weight: 900;
    }

    .hero-visual {
      position: relative;
    }

    .hero-image-shell {
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(33, 185, 255, 0.25);
      border-radius: 28px;
      background: linear-gradient(145deg, #0b1d32, #060d17);
      box-shadow: var(--shadow);
    }

    .hero-image-shell img {
      min-height: 460px;
      object-fit: cover;
    }

    .hero-image-shell::after {
      position: absolute;
      inset: 0;
      pointer-events: none;
      content: "";
      box-shadow: inset 0 0 60px rgba(2, 8, 15, 0.35);
    }

    .floating-card {
      position: absolute;
      bottom: -27px;
      left: -28px;
      width: min(310px, 78%);
      padding: 20px;
      border: 1px solid rgba(240, 185, 79, 0.32);
      border-radius: 17px;
      background: rgba(8, 20, 35, 0.92);
      box-shadow: var(--shadow);
      -webkit-backdrop-filter: blur(14px);
      backdrop-filter: blur(14px);
    }

    .floating-card small {
      display: block;
      margin-bottom: 7px;
      color: var(--gold);
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .floating-card strong {
      display: block;
      margin-bottom: 4px;
      font-size: 1.08rem;
    }

    .floating-card p {
      color: var(--text-muted);
      font-size: 0.86rem;
    }

    /* Trust strip */

    .trust-strip {
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      background: rgba(7, 18, 31, 0.68);
    }

    .trust-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
    }

    .trust-item {
      padding: 28px 20px;
      border-right: 1px solid var(--border);
      text-align: center;
    }

    .trust-item:last-child {
      border-right: 0;
    }

    .trust-item strong {
      display: block;
      margin-bottom: 3px;
      color: var(--primary);
      font-size: 1.25rem;
    }

    .trust-item span {
      color: var(--text-soft);
      font-size: 0.86rem;
    }

    /* Features */

    .feature-grid {
      display: grid;
      gap: 20px;
      grid-template-columns: repeat(3, 1fr);
    }

    .feature-card {
      position: relative;
      min-height: 245px;
      overflow: hidden;
      padding: 28px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background:
        linear-gradient(145deg, rgba(16, 40, 68, 0.66), rgba(7, 18, 31, 0.72));
      transition:
        transform 0.25s ease,
        border-color 0.25s ease;
    }

    .feature-card:hover {
      transform: translateY(-6px);
      border-color: var(--border-bright);
    }

    .feature-icon {
      display: grid;
      width: 52px;
      height: 52px;
      margin-bottom: 23px;
      place-items: center;
      border: 1px solid rgba(33, 185, 255, 0.3);
      border-radius: 15px;
      color: var(--primary);
      background: rgba(33, 185, 255, 0.08);
      font-size: 1.35rem;
      font-weight: 900;
    }

    .feature-card h3 {
      margin-bottom: 10px;
      font-size: 1.15rem;
    }

    .feature-card p {
      color: var(--text-soft);
      font-size: 0.94rem;
    }

    /* Strategies */

    .strategies {
      background:
        linear-gradient(180deg, transparent, rgba(9, 23, 40, 0.72), transparent);
    }

    .strategy-grid {
      display: grid;
      gap: 22px;
      grid-template-columns: repeat(3, 1fr);
    }

    .strategy-card {
      display: flex;
      min-height: 390px;
      flex-direction: column;
      padding: 31px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--panel);
      box-shadow: 0 18px 46px rgba(0, 0, 0, 0.2);
    }

    .strategy-number {
      display: inline-flex;
      width: 46px;
      height: 46px;
      align-items: center;
      justify-content: center;
      margin-bottom: 26px;
      border-radius: 13px;
      color: #05111d;
      background: var(--primary);
      font-weight: 900;
    }

    .strategy-card:nth-child(2) .strategy-number {
      background: var(--gold);
    }

    .strategy-card:nth-child(3) .strategy-number {
      color: white;
      background: #a05fdb;
    }

    .strategy-card h3 {
      margin-bottom: 5px;
      font-size: 1.42rem;
    }

    .strategy-tag {
      margin-bottom: 20px;
      color: var(--primary);
      font-size: 0.8rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .strategy-card p {
      margin-bottom: 20px;
      color: var(--text-soft);
      font-size: 0.94rem;
    }

    .strategy-list {
      display: grid;
      gap: 11px;
      margin-top: auto;
      list-style: none;
    }

    .strategy-list li {
      display: flex;
      gap: 10px;
      color: var(--text-soft);
      font-size: 0.9rem;
    }

    .strategy-list li::before {
      content: "✓";
      color: var(--green);
      font-weight: 900;
    }

    /* Dashboard */

    .dashboard-grid {
      display: grid;
      align-items: center;
      gap: 65px;
      grid-template-columns: 0.84fr 1.16fr;
    }

    .dashboard-copy h2 {
      margin-bottom: 20px;
      font-size: clamp(2rem, 4vw, 3.3rem);
      line-height: 1.12;
    }

    .dashboard-copy > p {
      margin-bottom: 27px;
      color: var(--text-soft);
    }

    .dashboard-points {
      display: grid;
      gap: 16px;
      list-style: none;
    }

    .dashboard-points li {
      display: flex;
      gap: 13px;
    }

    .dashboard-points strong {
      display: block;
      margin-bottom: 3px;
    }

    .dashboard-points span {
      color: var(--text-muted);
      font-size: 0.88rem;
    }

    .dashboard-image {
      overflow: hidden;
      padding: 10px;
      border: 1px solid var(--border-bright);
      border-radius: 24px;
      background: linear-gradient(145deg, #0d223b, #08121f);
      box-shadow: var(--shadow);
    }

    .dashboard-image img {
      min-height: 360px;
      border-radius: 16px;
      object-fit: cover;
      object-position: top left;
    }

    .image-note {
      margin-top: 13px;
      color: var(--text-muted);
      font-size: 0.78rem;
      text-align: center;
    }

    /* Risk */

    .risk-panel {
      display: grid;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 28px;
      background:
        radial-gradient(circle at 84% 20%, rgba(33, 185, 255, 0.13), transparent 27%),
        var(--panel-solid);
      box-shadow: var(--shadow);
      grid-template-columns: 0.95fr 1.05fr;
    }

    .risk-copy {
      padding: 55px;
    }

    .risk-copy h2 {
      margin-bottom: 18px;
      font-size: clamp(2rem, 4vw, 3.1rem);
      line-height: 1.12;
    }

    .risk-copy p {
      margin-bottom: 28px;
      color: var(--text-soft);
    }

    .risk-cards {
      display: grid;
      padding: 34px;
      gap: 14px;
      background: rgba(3, 10, 18, 0.3);
      grid-template-columns: repeat(2, 1fr);
    }

    .risk-card {
      padding: 21px;
      border: 1px solid var(--border);
      border-radius: 16px;
      background: rgba(10, 29, 50, 0.7);
    }

    .risk-card strong {
      display: block;
      margin-bottom: 6px;
      color: var(--primary);
    }

    .risk-card span {
      color: var(--text-soft);
      font-size: 0.88rem;
    }

    /* Pricing */

    .pricing-grid {
      display: grid;
      align-items: stretch;
      gap: 18px;
      grid-template-columns: repeat(5, 1fr);
    }

    .price-card {
      position: relative;
      display: flex;
      min-height: 370px;
      flex-direction: column;
      padding: 25px;
      border: 1px solid var(--border);
      border-radius: 20px;
      background: var(--panel);
      transition:
        transform 0.25s ease,
        border-color 0.25s ease;
    }

    .price-card:hover {
      transform: translateY(-5px);
      border-color: var(--border-bright);
    }

    .price-card.featured {
      border-color: rgba(240, 185, 79, 0.6);
      background:
        linear-gradient(155deg, rgba(240, 185, 79, 0.11), var(--panel));
    }

    .popular {
      position: absolute;
      top: 14px;
      right: 14px;
      padding: 5px 8px;
      border-radius: 999px;
      color: #171000;
      background: var(--gold);
      font-size: 0.65rem;
      font-weight: 900;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .plan-name {
      margin-bottom: 13px;
      color: var(--primary);
      font-size: 0.78rem;
      font-weight: 900;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .plan-duration {
      margin-bottom: 7px;
      font-size: 1.55rem;
      font-weight: 900;
    }

    .plan-price {
      margin-bottom: 20px;
      color: var(--text-soft);
      font-size: 0.9rem;
    }

    .plan-price strong {
      color: var(--text);
      font-size: 1.22rem;
    }

    .plan-features {
      display: grid;
      gap: 10px;
      margin-bottom: 25px;
      list-style: none;
    }

    .plan-features li {
      color: var(--text-soft);
      font-size: 0.84rem;
    }

    .plan-features li::before {
      margin-right: 7px;
      content: "✓";
      color: var(--green);
      font-weight: 900;
    }

    .price-card .button {
      width: 100%;
      margin-top: auto;
      padding: 0 12px;
    }

    /* Steps */

    .steps-grid {
      display: grid;
      gap: 18px;
      grid-template-columns: repeat(4, 1fr);
    }

    .step-card {
      padding: 27px;
      border-top: 2px solid var(--primary);
      border-radius: 0 0 18px 18px;
      background: rgba(10, 27, 46, 0.68);
    }

    .step-card small {
      color: var(--primary);
      font-weight: 900;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .step-card h3 {
      margin: 10px 0 9px;
    }

    .step-card p {
      color: var(--text-soft);
      font-size: 0.9rem;
    }

    /* FAQ */

    .faq-list {
      display: grid;
      width: min(100%, 880px);
      margin: 0 auto;
      gap: 12px;
    }

    .faq-item {
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 16px;
      background: var(--panel);
    }

    .faq-question {
      display: flex;
      width: 100%;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      padding: 21px 23px;
      border: 0;
      color: var(--text);
      background: transparent;
      font-weight: 800;
      text-align: left;
      cursor: pointer;
    }

    .faq-plus {
      color: var(--primary);
      font-size: 1.25rem;
      transition: transform 0.2s ease;
    }

    .faq-answer {
      max-height: 0;
      overflow: hidden;
      color: var(--text-soft);
      transition: max-height 0.28s ease;
    }

    .faq-answer p {
      padding: 0 23px 22px;
    }

    .faq-item.open .faq-plus {
      transform: rotate(45deg);
    }

    /* CTA */

    .cta-panel {
      position: relative;
      overflow: hidden;
      padding: 70px 55px;
      border: 1px solid var(--border-bright);
      border-radius: 28px;
      background:
        radial-gradient(circle at 78% 30%, rgba(33, 185, 255, 0.24), transparent 30%),
        linear-gradient(135deg, #0d2946, #081728);
      box-shadow: var(--shadow);
      text-align: center;
    }

    .cta-panel h2 {
      margin-bottom: 15px;
      font-size: clamp(2.2rem, 5vw, 4rem);
      line-height: 1;
    }

    .cta-panel p {
      width: min(100%, 700px);
      margin: 0 auto 28px;
      color: var(--text-soft);
    }

    .cta-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 13px;
    }

    /* Footer */

    .site-footer {
      padding: 65px 0 32px;
      border-top: 1px solid var(--border);
      background: #030810;
    }

    .footer-grid {
      display: grid;
      gap: 50px;
      grid-template-columns: 1.3fr 0.7fr 0.7fr 1fr;
    }

    .footer-brand p {
      max-width: 380px;
